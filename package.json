{
  "name": "lanterntrace-explorer",
  "version": "0.3.0",
  "description": "Electron prototype for exploring spotted lanternfly invasion-front evidence.",
  "author": "LanternTrace Explorer contributors",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "data:gbif": "node scripts/fetch-gbif-observations.mjs",
    "model:build": "python3 scripts/build-diffusion-model.py",
    "model:test": "python3 scripts/build-diffusion-model.py --verify",
    "pack": "npm run verify:release && electron-builder --dir && npm run verify:package",
    "verify:explanation": "node scripts/verify-explanation.cjs",
    "verify:release": "node --check app.js && node --check generated/model-results.js && node --check generated/frozen-benchmark.js && npm run verify:explanation && python3 research/verify_release.py",
    "verify:package": "node scripts/verify-packaged-app.cjs"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.2"
  },
  "build": {
    "appId": "org.lanterntrace.explorer",
    "productName": "LanternTrace Explorer",
    "icon": "assets/icon.icns",
    "asarUnpack": [
      "output/pdf/*.pdf"
    ],
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "data.js",
      "styles.css",
      "assets/**/*",
      "!assets/lanternfly-cutout-source.png",
      "generated/model-results.js",
      "generated/frozen-benchmark.js",
      "generated/observations.js",
      "output/pdf/lanterntrace-frontier-forecasting.pdf",
      "node_modules/**/*"
    ]
  }
}
